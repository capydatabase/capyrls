#!/bin/sh
# Conventional Commits gate for CapyDB repos that carry no Node toolchain.
#
# This is a dependency-free mirror of .commitlintrc.yml, which stays the single source of truth:
# CI runs the real @commitlint/cli against that file on every push, so if this script and the
# config ever drift apart, the push fails and the drift is visible. Keep the two in step.
#
# Wired through lefthook.yml (commit-msg hook). Also usable standalone:
#   git config core.hooksPath .githooks
#
# Mirrored rules (see docs/commit-conventions.md in the capydb workspace):
#   type-enum, type-case, type-empty, subject-empty  -> the header regex below
#   header-max-length                                -> 100
#   subject-full-stop                                -> no trailing "."
#   subject-case                                     -> subject may not start with an uppercase
#                                                       letter (commitlint's sentence/start/pascal/
#                                                       upper-case checks can only trip on that)
#   body-leading-blank                               -> warning only, matching commitlint level 1
# Deliberately not mirrored: body-max-line-length and footer-max-line-length, both disabled.

set -eu

msg_file="${1:?usage: commit-msg <commit-msg-file>}"

# Strip comments and everything below the `git commit --verbose` scissors line.
cleaned=$(awk '/^# *-+ >8 -+/ { exit } !/^#/ { print }' "$msg_file")

# git's default cleanup drops leading blank lines, so the header is the first non-blank line.
header=$(printf '%s\n' "$cleaned" | awk 'NF { print; exit }')
header=$(printf '%s' "$header" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')

# commitlint's defaultIgnores: merges, reverts and rebase autosquash markers are never linted.
case "$header" in
	Merge\ * | Auto-merged\ * | Automatic\ merge* | Revert\ * | revert\ * | fixup!* | squash!*)
		exit 0
		;;
esac

types='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test'
errors=''
fail() { errors="${errors}  - $1
"; }

if ! printf '%s\n' "$header" | grep -qE "^($types)(\([^()]+\))?!?: [^[:space:]].*$"; then
	fail "header must be '<type>[(scope)][!]: <subject>' with type one of: $(printf '%s' "$types" | tr '|' ' ')"
else
	subject=${header#*: }

	if [ "${#header}" -gt 100 ]; then
		fail "header is ${#header} characters; the limit is 100 [header-max-length]"
	fi

	case "$subject" in
		*.) fail "subject may not end with a period [subject-full-stop]" ;;
	esac

	case "$subject" in
		[A-Z]*) fail "subject may not start with an uppercase letter [subject-case]" ;;
	esac
fi

# body-leading-blank is a warning in commitlint, so it warns here too and never blocks a commit.
second_line=$(printf '%s\n' "$cleaned" | awk 'NF { found = 1 } found { n++; if (n == 2) { print; exit } }')
if [ -n "$second_line" ]; then
	printf '⚠ commit-msg: leave a blank line between the subject and the body [body-leading-blank]\n' >&2
fi

if [ -n "$errors" ]; then
	printf '\n✖ commit message does not follow Conventional Commits:\n\n' >&2
	printf '  %s\n\n' "$header" >&2
	printf '%s\n' "$errors" >&2
	printf 'Rules: .commitlintrc.yml   Examples: https://www.conventionalcommits.org\n\n' >&2
	exit 1
fi
